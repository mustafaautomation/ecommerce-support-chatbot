# mock is the default. No key required.
LLM_PROVIDER=mock

# Optional. When set to openai or groq, the desk still executes tools in code.
# LLM_PROVIDER=groq
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# SQLite file. Use :memory: in tests.
# DW_DB_PATH=data/driftwood.sqlite
