# Offline demo mode is the default. Leave the keys empty and Rowan still runs.
# Set DW_FORCE_OFFLINE=1 to ignore keys (CI does this by simply not setting them).

# Primary model. Tool calling via the OpenAI-compatible Groq API.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Fallback when Groq errors or is unset.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Channel webhook verify tokens. Local and CI use driftwood-demo-verify when unset.
# WHATSAPP_VERIFY_TOKEN=
# MESSENGER_VERIFY_TOKEN=
# Outbound Cloud API tokens are optional. Without them the webhooks still answer
# and return the reply in JSON so the demo and tests do not call Meta.
# WHATSAPP_TOKEN=
# MESSENGER_PAGE_TOKEN=

# SQLite file. Tests use :memory:.
# DW_DB_PATH=data/driftwood.sqlite
